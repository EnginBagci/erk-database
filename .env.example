# Bu dosyayı .env olarak kopyala ve gerçek değerlerle doldur.
# .env dosyası .gitignore içinde -- repoya asla commit etme.

# --- Veritabanı ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=erk_arac_db
DB_USER=postgres
DB_PASSWORD=

# --- DMS API ---
DMS_API_HOST=192.168.20.95:8081
DMS_APP_KEY=4B9D26B7-89D3-422D-AE11-CCAEAD45803A

# direct = Python doğrudan DMS API'sine bağlanır (auth kısmı doğrulanmalı)
# proxy  = mevcut dms-app (http://localhost:4000) üzerinden gider
DMS_API_MODE=direct
DMS_PROXY_BASE_URL=http://localhost:4000
